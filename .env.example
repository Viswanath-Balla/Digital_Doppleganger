# Digital Doppelgänger — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Mode ---
SAMPLE_MODE=true

# --- Nightshift (LLM provider) ---
NIGHTSHIFT_BASE_URL=https://your-nightshift-endpoint.example.com/v1
NIGHTSHIFT_API_KEY=PLACEHOLDER_NIGHTSHIFT_KEY

# --- Model IDs (via Nightshift) ---
MODEL_EXTRACTOR=PLACEHOLDER_EXTRACTOR_MODEL
MODEL_REDTEAM=PLACEHOLDER_NEMOTRON_MODEL
MODEL_VERIFIER=PLACEHOLDER_NEMOTRON_MODEL

# --- Zetaris (data layer) ---
ZETARIS_HOST=localhost
ZETARIS_PORT=5432
ZETARIS_USER=PLACEHOLDER_USER
ZETARIS_PASSWORD=PLACEHOLDER_PASSWORD
ZETARIS_DATABASE=PLACEHOLDER_DB
ZETARIS_JDBC_URL=jdbc:zetaris://localhost:5432/PLACEHOLDER_DB
